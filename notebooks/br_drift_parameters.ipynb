    "def alter_br_samples(df, changes):\n",
    "    updated = df.copy()\n",
    "    \n",
    "    for col, opts in changes.items():\n",
    "        start = opts[\"start\"]\n",
    "        step = opts[\"step\"]  # e.g., 0.01 for +1%, -0.01 for -1%\n",
    "        \n",
    "        values = []\n",
    "        for i in range(len(updated)):\n",
    "            block = i // 200  # every 20 rows\n",
    "            value = start * (1 + step * block)\n",
    "            values.append(value)\n",
    "        \n",
    "        updated[col] = values\n",
    "    \n",
    "    return updated\n",
    "\n",
    "br._samples = alter_br_samples(br._samples, changes)"
   ]
