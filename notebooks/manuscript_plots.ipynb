    "import os\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import math\n",
    "from scipy.stats import norm\n",
    "\n",
    "\n",
    "def plot_posteriors_from_calibration(n_samples, n_params, calibration_dir):\n",
    "    \"\"\"\n",
    "    Plot prior vs posterior distributions for all parameters except 'T'.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    n_samples : int\n",
    "        Number of samples used in the calibration.\n",
    "    n_params : int\n",
    "        Number of parameters.\n",
    "    calibration_dir : str\n",
    "        Folder containing 'posterior_mean.csv' and 'posterior_covariance.csv'\n",
    "    \"\"\"\n",
    "\n",
    "    # Constants (do not change)\n",
    "    which_obs = 3\n",
    "    output_path = \"../output_synthetic/\"\n",
    "    true_input_path = \"../dummy_data/pure_input_dummy_data.csv\"\n",
    "    true_obs_path = \"../dummy_data/output_dummy_data/waveform_resampled_all_pressure_traces_rv_with_pca.csv\"\n",
    "\n",
    "    # File suffix\n",
    "    file_suffix = f\"_{n_samples}_{n_params}_params\"\n",
    "\n",
    "    # Load data\n",
    "    true_input = pd.read_csv(true_input_path)\n",
    "    true_observations = pd.read_csv(true_obs_path)\n",
    "    input_prior = pd.read_csv(f'{output_path}/pure_input{file_suffix}.csv')\n",
    "\n",
    "    param_names = input_prior.columns.tolist()\n",
    "\n",
    "    # Build priors\n",
    "    mu_0 = np.array(input_prior.mean())\n",
    "    Sigma_0 = np.diag(input_prior.var())\n",
    "\n",
    "    # Override T with iT value\n",
    "    ind = input_prior.columns.get_loc(\"T\")\n",
    "    mu_0[ind] = true_observations['iT'].iloc[which_obs]\n",
    "    Sigma_0[ind, ind] = 0.01\n",
    "\n",
    "    # Load posterior mean and covariance\n",
    "    Mu_post = pd.read_csv(os.path.join(calibration_dir, \"posterior_mean.csv\")).values.flatten()\n",
    "    Sigma_post = pd.read_csv(os.path.join(calibration_dir, \"posterior_covariance.csv\"))\n",
    "    posterior_stds = np.sqrt(np.diag(Sigma_post))\n",
    "\n",
    "    # Remove parameter \"T\"\n",
    "    filtered_indices = [i for i, p in enumerate(param_names) if p != \"T\"]\n",
    "    param_names = [p for p in param_names if p != \"T\"]\n",
    "\n",
    "    prior_means = mu_0[filtered_indices]\n",
    "    prior_stds = np.sqrt(np.diag(Sigma_0))[filtered_indices]\n",
    "    posterior_means = Mu_post[filtered_indices]\n",
    "    posterior_stds = posterior_stds[filtered_indices]\n",
    "\n",
    "    true_values = true_input.loc[which_obs, param_names].values\n",
    "\n",
    "    # Plot\n",
    "    fig, axes = plt.subplots(2, math.ceil(len(param_names)/2), figsize=(18, 8))\n",
    "    axes = axes.flatten()\n",
    "\n",
    "    for i, ax in enumerate(axes[:len(param_names)]):\n",
    "        x_min = min(prior_means[i] - 3 * prior_stds[i], posterior_means[i] - 3 * posterior_stds[i])\n",
    "        x_max = max(prior_means[i] + 3 * prior_stds[i], posterior_means[i] + 3 * posterior_stds[i])\n",
    "        x = np.linspace(x_min, x_max, 100)\n",
    "\n",
    "        prior_pdf = norm.pdf(x, prior_means[i], prior_stds[i])\n",
    "        posterior_pdf = norm.pdf(x, posterior_means[i], posterior_stds[i])\n",
    "\n",
    "        ax.plot(x, prior_pdf, label=\"Prior\", linestyle=\"dashed\", color=\"blue\")\n",
    "        ax.plot(x, posterior_pdf, label=\"Posterior\", linestyle=\"solid\", color=\"red\")\n",
    "        ax.axvline(true_values[i], color=\"green\", linestyle=\"dotted\", label=\"True Value\")\n",
    "\n",
    "        ax.set_title(param_names[i])\n",
    "        ax.set_xlabel(\"Value\")\n",
    "        ax.set_ylabel(\"Density\")\n",
    "\n",
    "    # Remove unused axes\n",
    "    for ax in axes[len(param_names):]:\n",
    "        ax.remove()\n",
    "\n",
    "    fig.tight_layout()\n",
    "    plt.subplots_adjust(bottom=0.14)\n",
    "\n",
    "    handles = [\n",
    "        plt.Line2D([0], [0], color=\"blue\", linestyle=\"dashed\", label=\"Prior\"),\n",
    "        plt.Line2D([0], [0], color=\"red\", linestyle=\"solid\", label=\"Posterior\"),\n",
    "        plt.Line2D([0], [0], color=\"green\", linestyle=\"dotted\", label=\"True Value\")\n",
    "    ]\n",
    "    fig.legend(handles=handles, ncol=3, fontsize=14, loc=\"lower center\")\n",
    "\n",
    "    plt.show()"
   ]
